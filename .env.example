# Snowflake
SNOWFLAKE_ACCOUNT=myaccount.snowflakecomputing.com
SNOWFLAKE_USER=myuser
SNOWFLAKE_PASSWORD=mypassword
SNOWFLAKE_DATABASE=INSIGHTS_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Cortex Agent
CORTEX_AGENT_BASE_URL=https://cortex.example.com
CORTEX_AGENT_API_KEY=your_api_key_here

# Email
EMAIL_PROVIDER=stub         # stub | ses | sendgrid | smtp
EMAIL_FROM_ADDRESS=insights@yourdomain.com

# Weave
WEAVE_PROJECT_NAME=cortex-insights

# Batch config
MAX_RETRIES=3
BATCH_CONCURRENCY=5
